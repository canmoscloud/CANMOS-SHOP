# CANMOS-SHOP - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Supabase
SUPABASE_URL=https://sua-url.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_sua-chave-aqui
STRIPE_SECRET_KEY=sk_live_sua-chave-aqui
STRIPE_WEBHOOK_SECRET=whsec_seu-webhook-secret-aqui

# Stripe Price ID (Premium Monthly)
STRIPE_PRICE_PREMIUM=price_id_do_plano_premium

# AbacatePay
ABACATEPAY_API_KEY=sua-chave-abacatepay-aqui

# App URL (para webhooks)
SITE_URL=http://localhost:3000
